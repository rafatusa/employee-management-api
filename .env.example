# Local development environment.
# Copy to .env and fill in — .env is gitignored and never committed.
#
# In deployed environments these values are rendered by Chef from terraform
# outputs and repository secrets; nothing here is used in CI.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=employees
DB_USER=employees
DB_PASSWORD=changeme-local-only

API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=changeme-local-only

SERVER_PORT=8080
