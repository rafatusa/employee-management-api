<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
      JPA entities expose mutable java.time and collection state by design; the
      EI_EXPOSE_REP family flags every getter/setter pair on them. LocalDate is
      immutable, so these reports are false positives here.
    -->
    <Match>
        <Class name="~.*\.employee\.Employee"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Records are immutable carriers; the same exposure pattern applies. -->
    <Match>
        <Class name="~.*\.employee\.Employee(Request|Response)"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Spring configuration classes return framework-managed beans; SpotBugs cannot
      see the container's lifecycle and reports unread fields on injected values.
    -->
    <Match>
        <Class name="~.*\.config\.SecurityConfig"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
