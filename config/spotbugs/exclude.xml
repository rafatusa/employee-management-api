<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 across the application classes.

      SpotBugs reports these whenever a constructor stores, or a getter returns,
      an object reference it did not defensively copy. Every occurrence in this
      codebase is one of:

        * java.time.LocalDate on the Employee entity and the request/response
          records — LocalDate is immutable, so there is nothing to defensively
          copy and a copy would be pure overhead.
        * Spring-managed collaborators injected through constructors
          (EmployeeRepository into EmployeeService, EmployeeService into
          EmployeeController). These are container-managed singletons; copying
          them is not merely wasteful, it would break dependency injection.

      This suppresses a known false-positive class, not real findings: every
      other SpotBugs detector remains active at MAX effort / MEDIUM confidence,
      and ignoreFailures stays false.
    -->
    <Match>
        <Package name="~com\.example\.employeemanagementapi.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
